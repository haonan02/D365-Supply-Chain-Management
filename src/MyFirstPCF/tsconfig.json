{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "es2015"],
    "jsx": "react",
    "module": "esnext",
    "moduleResolution": "node",
    "paths": {
      "*": ["./node_modules/*", "./node_modules/@types/*"]
    },
    "strict": true,
    "strictPropertyInitialization": false, 
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": false,
    "sourceMap": true,
    "importHelpers": true,
    "outDir": "./generated",
    "rootDir": "."
  }
}